SERVER_PORT=3000
ENV=development
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=120
SERVER_SHUTDOWN_TIMEOUT=30

# Database
# app_user (created by migrations/043_restricted_app_role.sql), NOT
# postgres — the app refuses to start against a superuser/BYPASSRLS role
# because that silently disables every row-level-security policy (see the
# migration file for the full story). Use `postgres` only for
# scripts/migrate.sh, scripts/backup-db.sh, scripts/restore-db.sh.
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_user_dev_password
DB_NAME=live_platform
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=3600
DB_MAX_CONN_IDLE=1800

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=stream-events

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=recordings
MINIO_MATERIALS_BUCKET=materials
MINIO_DOWNLOADS_BUCKET=downloads

# JWT (CHANGE IN PRODUCTION)
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# RTMP
RTMP_SERVER_URL=rtmp://localhost:1935/live
RTMP_STREAM_KEY=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30
# Second, tenant-keyed budget on authenticated routes — keeps one
# tenant's traffic spike from throttling another tenant sharing an IP/NAT.
RATE_LIMIT_TENANT_RPM=1200
RATE_LIMIT_TENANT_BURST=300

# TLS (optional — set TLS_ENABLED=true for HTTPS)
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Claude AI (for doubt solving)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048

# Razorpay (for subscriptions)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS (MSG91, for OTP delivery — leave AUTH_KEY blank to log OTPs instead of sending)
SMS_PROVIDER=msg91
SMS_AUTH_KEY=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE=
SMS_BASE_URL=https://control.msg91.com/api/v5

# WhatsApp (Gupshup, for broadcast — leave API_KEY blank to disable)
WHATSAPP_PROVIDER=gupshup
WHATSAPP_API_KEY=
WHATSAPP_SOURCE=
WHATSAPP_APP_NAME=
WHATSAPP_BASE_URL=https://api.gupshup.io/sm/api/v1

# Push notifications — FCM HTTP v1. Set ONE of the two service-account
# options (JSON wins if both set). Leave both blank to disable push.
PUSH_PROVIDER=fcm
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=
FCM_BASE_URL=https://fcm.googleapis.com
FCM_TIMEOUT=6
FCM_MAX_CONCURRENCY=20

# Codemagic (per-tenant white-label app build pipeline — leave blank for
# manual mode: build rows are still created for a human to pick up)
CODEMAGIC_API_TOKEN=
CODEMAGIC_WORKFLOW_ID=
CODEMAGIC_APP_ID=
CODEMAGIC_BASE_URL=https://api.codemagic.io
CODEMAGIC_WEBHOOK_SECRET=

# App
APP_BASE_URL=http://localhost:3000
HLS_BASE_URL=http://localhost:8080/hls
RTMP_BASE_URL=rtmp://localhost:1935/live
DEFAULT_LOCALE=en
